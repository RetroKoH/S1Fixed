(2)   72/      32 :                     zCheckForSamples:
(2)   73/      32 : 21 FF 1F            	ld	hl,zDAC_Sample			; Load the address of next sample.
(2)   74/      35 :                     
(2)   75/      35 :                     zWaitDACLoop:
(2)   76/      35 : 7E                  	ld	a,(hl)				; a = next sample to play.
(2)   77/      36 : B7                  	or	a				; Do we have a valid sample?
(2)   78/      37 : F2 35 00            	jp	p,zWaitDACLoop			; Loop until we do
(2)   79/      3A :                     
(2)   80/      3A : D6 81               	sub	81h				; Make 0-based index
(2)   81/      3C : 77                  	ld	(hl),a				; Store it back into sample index (i.e., mark it as being played)
(2)   82/      3D : FE 06               	cp	6				; Is the sample 87h or higher?
(2)   83/      3F : 30 78               	jr	nc,zPlay_SegaPCM		; If yes, branch
(2)   84/      41 :                     
(2)   85/      41 : 11 00 00            	ld	de,0				; de = 0
(2)   86/      44 : FD 21 D6 00         	ld	iy,zPCM_Table			; iy = pointer to PCM Table
(2)   87/      48 :                     
(2)   88/      48 :                     	; Each entry on PCM table has 8 bytes in size, so multiply a by 8
(2)   89/      48 :                     	; Warning: do NOT play samples 84h-86h!
(2)   90/      48 : CB 27               	sla	a
(2)   91/      4A : CB 27               	sla	a
(2)   92/      4C : CB 27               	sla	a
(2)   93/      4E : 06 00               	ld	b,0				; b = 0
(2)   94/      50 : 4F                  	ld	c,a				; c = a
(2)   95/      51 : FD 09               	add	iy,bc				; iy = pointer to DAC sample entry
(2)   96/      53 : FD 5E 00            	ld	e,(iy+0)			; e = low byte of sample location
(2)   97/      56 : FD 56 01            	ld	d,(iy+1)			; de = pointer location of DAC sample
(2)   98/      59 : FD 4E 02            	ld	c,(iy+2)			; c = low byte of sample size
(2)   99/      5C : FD 46 03            	ld	b,(iy+3)			; bc = size of the DAC sample
(2)  100/      5F : D9                  	exx					; bc' = size of sample, de' = location of sample, hl' = pointer to zDAC_Sample
(2)  101/      60 : 16 80               	ld	d,80h				; d = is an accumulator; this initializes it to 80h
(2)  102/      62 : 21 FD 1F            	ld	hl,zDAC_Status			; hl = pointer to zDAC_Status
(2)  103/      65 : 72                  	ld	(hl),d				; Set flag to not accept driver input
(2)  104/      66 : DD 36 00 2B         	ld	(ix+0),2Bh			; Select enable/disable DAC register
(2)  105/      6A : 1E 2A               	ld	e,2Ah				; Command to select DAC output register
(2)  106/      6C : FD 4E 04            	ld	c,(iy+4)			; c = pitch of the DAC sample
(2)  107/      6F : DD 72 01            	ld	(ix+1),d			; Enable DAC
(2)  108/      72 : 36 00               	ld	(hl),0				; Set flag to accept driver input
(2)  109/      74 :                     	; After the following exx, we have:
(2)  110/      74 :                     	; bc = size of sample, de = location of sample, hl = pointer to zDAC_Sample,
(2)  111/      74 :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  112/      74 :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  113/      74 : D9                  	exx
(2)  114/      75 : 26 00               	ld	h,(zDACDecodeTbl&0FF00h)>>8	; We set low byte of pointer below
(2)  115/      77 :                     
(2)  116/      77 :                     zPlayPCMLoop:
(2)  117/      77 : 1A                  	ld	a,(de)			; 7	; a = byte from DAC sample
(2)  118/      78 : E6 F0               	and	0F0h			; 7	; Get upper nibble
(2)  119/      7A :                     	; Shift-right 4 times to rotate the nibble into place
(2)  120/      7A : 0F                  	rrca				; 4
(2)  121/      7B : 0F                  	rrca				; 4
(2)  122/      7C : 0F                  	rrca				; 4
(2)  123/      7D : 0F                  	rrca				; 4
(2)  124/      7E : C6 22               	add	a,zDACDecodeTbl&0FFh	; 7	; Add in low byte of offset into decode table
(2)  125/      80 : 6F                  	ld	l,a			; 4	; hl = pointer to nibble entry in JMan2050 table
(2)  126/      81 : 7E                  	ld	a,(hl)			; 7	; a = JMan2050 entry for current nibble
(2)  127/      82 :                     	; After the following exx, we have:
(2)  128/      82 :                     	; bc' = size of sample, de' = location of sample, hl' = pointer to nibble entry in JMan2050 table,
(2)  129/      82 :                     	; c = pitch of sample, d = PCM accumulator,
(2)  130/      82 :                     	; e = command to select DAC output register, hl = pointer to DAC status
(2)  131/      82 : D9                  	exx				; 4
(2)  132/      83 : 82                  	add	a,d			; 4	; Add accumulator value...
(2)  133/      84 : 57                  	ld	d,a			; 4	; ... then store value back into accumulator
(2)  134/      85 : 75                  	ld	(hl),l			; 7	; Set flag to not accept driver input (l = FFh)
(2)  135/      86 : DD 73 00            	ld	(ix+0),e		; 19	; Select DAC output register
(2)  136/      89 : DD 72 01            	ld	(ix+1),d		; 19	; Send current data
(2)  137/      8C : 74                  	ld	(hl),h			; 7	; Set flag to accept driver input (h = 1Fh)
(2)  138/      8D :                     
(2)  139/      8D : 41                  	ld	b,c			; 4	; b = sample pitch
(2)  140/      8E : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  141/      90 :                     
(2)  142/      90 :                     	; After the following exx, we have:
(2)  143/      90 :                     	; bc = size of sample, de = location of sample, hl = pointer to nibble entry in JMan2050 table,
(2)  144/      90 :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  145/      90 :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  146/      90 : D9                  	exx				; 4
(2)  147/      91 : 1A                  	ld	a,(de)			; 7	; a = byte from DAC sample
(2)  148/      92 : E6 0F               	and	0Fh			; 7	; Want only lower nibble now
(2)  149/      94 : C6 22               	add	a,zDACDecodeTbl&0FFh	; 7	; Add in low byte of offset into decode table
(2)  150/      96 : 6F                  	ld	l,a			; 4	; hl = pointer to nibble entry in JMan2050 table
(2)  151/      97 : 7E                  	ld	a,(hl)			; 7	; a = JMan2050 entry for current nibble
(2)  152/      98 :                     	; After the following exx, we have:
(2)  153/      98 :                     	; bc' = size of sample, de' = location of sample, hl' = pointer to nibble entry in JMan2050 table,
(2)  154/      98 :                     	; c = pitch of sample, d = PCM accumulator,
(2)  155/      98 :                     	; e = command to select DAC output register, hl = pointer to DAC status
(2)  156/      98 : D9                  	exx				; 4
(2)  157/      99 : 82                  	add	a,d			; 4	; Add accumulator value...
(2)  158/      9A : 57                  	ld	d,a			; 4	; ... then store value back into accumulator
(2)  159/      9B : 75                  	ld	(hl),l			; 7	; Set flag to not accept driver input (l = FFh)
(2)  160/      9C : DD 73 00            	ld	(ix+0),e		; 19	; Select DAC output register
(2)  161/      9F : DD 72 01            	ld	(ix+1),d		; 19	; Send current data
(2)  162/      A2 : 74                  	ld	(hl),h			; 7	; Set flag to accept driver input (h = 1Fh)
(2)  163/      A3 :                     
(2)  164/      A3 : 41                  	ld	b,c			; 4	; b = sample pitch
(2)  165/      A4 : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  166/      A6 :                     
(2)  167/      A6 :                     	; After the following exx, we have:
(2)  168/      A6 :                     	; bc = size of sample, de = location of sample, hl = pointer to nibble entry in JMan2050 table,
(2)  169/      A6 :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  170/      A6 :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  171/      A6 : D9                  	exx				; 4
(2)  172/      A7 : 3A FF 1F            	ld	a,(zDAC_Sample)		; 13	; a = sample we're playing (minus 81h)
(2)  173/      AA : CB 7F               	bit	7,a			; 8	; Test bit 7 of register a
(2)  174/      AC : C2 32 00            	jp	nz,zCheckForSamples	; 10	; If it is set, we need to get a new sample
(2)  175/      AF :                     
(2)  176/      AF : 13                  	inc	de			; 6	; Point to next byte of DAC sample
(2)  177/      B0 : 0B                  	dec	bc			; 6	; Decrement remaining bytes on DAC sample
(2)  178/      B1 : 79                  	ld	a,c			; 4	; a = low byte of remainig bytes
(2)  179/      B2 : B0                  	or	b			; 4	; Are there any bytes left?
(2)  180/      B3 : C2 77 00            	jp	nz,zPlayPCMLoop		; 10	; If yes, keep playing sample
(2)  181/      B6 :                     					; 301 in total
(2)  182/      B6 : C3 32 00            	jp	zCheckForSamples		; Sample is done; wait for new samples
(2)  183/      B9 :                     ;
(2)  184/      B9 :                     ; Subroutine - Play_SegaPCM
(2)  185/      B9 :                     ;
(2)  186/      B9 :                     ; This subroutine plays the "SEGA" sound.
