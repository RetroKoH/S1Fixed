(2)   16/   E070A : =$1                  SMPS2ASMVer	= 1
(2)   17/   E070A :                     
(2)   18/   E070A :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   E070A : =$C                  psgdelta	EQU 12
(2)   20/   E070A :                     ; ---------------------------------------------------------------------------
(2)   21/   E070A :                     ; Standard Octave Pitch Equates
(2)   22/   E070A :                     	enumconf	$C
(2)   23/   E070A : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   E070A : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   E070A : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   E070A : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   E070A : =$78                 	nextenum	smpsPitch10hi
(2)   28/   E070A :                     	enumconf	1
(2)   29/   E070A :                     ; ---------------------------------------------------------------------------
(2)   30/   E070A :                     ; Note Equates
(2)   31/   E070A : =$80..$8F            	enum		nRst=$80,nC0,nCs0,nD0,nEb0,nE0,nF0,nFs0,nG0,nAb0,nA0,nBb0,nB0,nC1,nCs1,nD1
(2)   32/   E070A : =$90..$9F            	nextenum	nEb1,nE1,nF1,nFs1,nG1,nAb1,nA1,nBb1,nB1,nC2,nCs2,nD2,nEb2,nE2,nF2,nFs2
(2)   33/   E070A : =$A0..$AF            	nextenum	nG2,nAb2,nA2,nBb2,nB2,nC3,nCs3,nD3,nEb3,nE3,nF3,nFs3,nG3,nAb3,nA3,nBb3
(2)   34/   E070A : =$B0..$BF            	nextenum	nB3,nC4,nCs4,nD4,nEb4,nE4,nF4,nFs4,nG4,nAb4,nA4,nBb4,nB4,nC5,nCs5,nD5
(2)   35/   E070A : =$C0..$CF            	nextenum	nEb5,nE5,nF5,nFs5,nG5,nAb5,nA5,nBb5,nB5,nC6,nCs6,nD6,nEb6,nE6,nF6,nFs6
(2)   36/   E070A : =$D0..$DF            	nextenum	nG6,nAb6,nA6,nBb6,nB6,nC7,nCs7,nD7,nEb7,nE7,nF7,nFs7,nG7,nAb7,nA7,nBb7
(2)   37/   E070A :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   38/   E070A :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   39/   E070A :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   40/   E070A :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   42/   E070A : =$C6                 nMaxPSG				EQU nA5
(2)   43/   E070A : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   44/   E070A : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   50/   E070A :                     ; ---------------------------------------------------------------------------
(2)   51/   E070A :                     ; PSG volume envelope equates
(2)   54/   E070A : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   55/   E070A : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   75/   E070A :                     ; ---------------------------------------------------------------------------
(2)   76/   E070A :                     ; DAC Equates
(2)   79/   E070A : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   80/   E070A : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  158/   E070A :                     ; ---------------------------------------------------------------------------
(2)  159/   E070A :                     ; Channel IDs for SFX
(2)  160/   E070A : =$80                 cPSG1				EQU $80
(2)  161/   E070A : =$A0                 cPSG2				EQU $A0
(2)  162/   E070A : =$C0                 cPSG3				EQU $C0
(2)  163/   E070A : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  164/   E070A : =$2                  cFM3				EQU $02
(2)  165/   E070A : =$4                  cFM4				EQU $04
(2)  166/   E070A : =$5                  cFM5				EQU $05
(2)  167/   E070A : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  168/   E070A :                     ; ---------------------------------------------------------------------------
(2)  169/   E070A :                     ; Conversion macros and functions
(2)  170/   E070A :                     
(2)  171/   E070A :                     conv0To256  function n,((n==0)<<8)|n
(2)  172/   E070A :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  173/   E070A :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  174/   E070A :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  175/   E070A :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  176/   E070A :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  177/   E070A :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  178/   E070A :                     
(2)  179/   E070A :                     convertMainTempoMod macro mod
(2)  180/   E070A :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  181/   E070A :                     		dc.b	mod
(2)  182/   E070A :                     	elseif SourceDriver==1
(2)  183/   E070A :                     		if mod==1
(2)  184/   E070A :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  185/   E070A :                     		endif
(2)  186/   E070A :                     		if SonicDriverVer==2
(2)  187/   E070A :                     			dc.b	s1TempotoS2(mod)
(2)  188/   E070A :                     		else;if SonicDriverVer>=3
(2)  189/   E070A :                     			dc.b	s1TempotoS3(mod)
(2)  190/   E070A :                     		endif
(2)  191/   E070A :                     	elseif SourceDriver==2
(2)  192/   E070A :                     		if mod==0
(2)  193/   E070A :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  194/   E070A :                     		endif
(2)  195/   E070A :                     		if SonicDriverVer==1
(2)  196/   E070A :                     			dc.b	s2TempotoS1(mod)
(2)  197/   E070A :                     		else;if SonicDriverVer>=3
(2)  198/   E070A :                     			dc.b	s2TempotoS3(mod)
(2)  199/   E070A :                     		endif
(2)  200/   E070A :                     	else;if SourceDriver>=3
(2)  201/   E070A :                     		if mod==0
(2)  202/   E070A :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  203/   E070A :                     		endif
(2)  204/   E070A :                     		if SonicDriverVer==1
(2)  205/   E070A :                     			dc.b	s3TempotoS1(mod)
(2)  206/   E070A :                     		else;if SonicDriverVer==2
(2)  207/   E070A :                     			dc.b	s3TempotoS2(mod)
(2)  208/   E070A :                     		endif
(2)  209/   E070A :                     	endif
(2)  210/   E070A :                     	endm
(2)  211/   E070A :                     
(2)  212/   E070A :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  213/   E070A :                     PSGPitchConvert macro pitch
(2)  214/   E070A :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  215/   E070A :                     		dc.b	(pitch+psgdelta)&$FF
(2)  216/   E070A :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  217/   E070A :                     		dc.b	(pitch-psgdelta)&$FF
(2)  218/   E070A :                     	else
(2)  219/   E070A :                     		dc.b	pitch
(2)  220/   E070A :                     	endif
(2)  221/   E070A :                     	endm
(2)  222/   E070A :                     
(2)  223/   E070A :                     CheckedChannelPointer macro loc
(2)  224/   E070A :                     	if SonicDriverVer<>1
(2)  225/   E070A :                     		dc.w	z80_ptr(loc)
(2)  226/   E070A :                     	else
(2)  227/   E070A :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  228/   E070A :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  229/   E070A :                     		endif
(2)  230/   E070A :                     		dc.w	loc-songStart
(2)  231/   E070A :                     	endif
(2)  232/   E070A :                     	endm
(2)  233/   E070A :                     ; ---------------------------------------------------------------------------
(2)  234/   E070A :                     ; Header Macros
(2)  235/   E070A :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  236/   E070A :                     
(2)  237/   E070A :                     SourceDriver set ver
(2)  238/   E070A :                     
(2)  239/   E070A :                     	if ("sourcesmps2asmver"<>"")
(2)  240/   E070A :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  241/   E070A :                     	else
(2)  242/   E070A :                     		set SourceSMPS2ASM,0
(2)  243/   E070A :                     	endif
(2)  244/   E070A :                     
(2)  245/   E070A :                     songStart set *
(2)  246/   E070A :                     
(2)  247/   E070A :                     	if MOMPASS=1
(2)  248/   E070A :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  249/   E070A :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  250/   E070A :                     		endif
(2)  251/   E070A :                     	endif
(2)  252/   E070A :                     
(2)  253/   E070A :                     	endm
(2)  254/   E070A :                     
(2)  255/   E070A :                     smpsHeaderVoiceNull macro
(2)  256/   E070A :                     	if songStart<>*
(2)  257/   E070A :                     		fatal "Missing smpsHeaderStartSong"
(2)  258/   E070A :                     	endif
(2)  259/   E070A :                     	dc.w	$0000
(2)  260/   E070A :                     	endm
(2)  261/   E070A :                     
(2)  262/   E070A :                     ; Header - Set up Voice Location
(2)  263/   E070A :                     ; Common to music and SFX
(2)  264/   E070A :                     smpsHeaderVoice macro loc
(2)  265/   E070A :                     	if songStart<>*
(2)  266/   E070A :                     		fatal "Missing smpsHeaderStartSong"
(2)  267/   E070A :                     	endif
(2)  268/   E070A :                     	if SonicDriverVer<>1
(2)  269/   E070A :                     		dc.w	z80_ptr(loc)
(2)  270/   E070A :                     	else
(2)  271/   E070A :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  272/   E070A :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  273/   E070A :                     		endif
(2)  274/   E070A :                     		dc.w	loc-songStart
(2)  275/   E070A :                     	endif
(2)  276/   E070A :                     	endm
(2)  277/   E070A :                     
(2)  278/   E070A :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  279/   E070A :                     ; Common to music and SFX
(2)  280/   E070A :                     smpsHeaderVoiceUVB macro
(2)  281/   E070A :                     	if songStart<>*
(2)  282/   E070A :                     		fatal "Missing smpsHeaderStartSong"
(2)  283/   E070A :                     	endif
(2)  284/   E070A :                     	if SonicDriverVer>=5
(2)  285/   E070A :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  286/   E070A :                     	elseif SonicDriverVer>=3
(2)  287/   E070A :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  288/   E070A :                     	else
(2)  289/   E070A :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  290/   E070A :                     	endif
(2)  291/   E070A :                     	endm
(2)  292/   E070A :                     
(2)  293/   E070A :                     ; Header macros for music (not for SFX)
(2)  294/   E070A :                     ; Header - Set up Channel Usage
(2)  295/   E070A :                     smpsHeaderChan macro fm,psg
(2)  296/   E070A :                     	dc.b	fm,psg
(2)  297/   E070A :                     	endm
(2)  298/   E070A :                     
(2)  299/   E070A :                     ; Header - Set up Tempo
(2)  300/   E070A :                     smpsHeaderTempo macro div,mod
(2)  301/   E070A :                     	dc.b	div
(2)  302/   E070A :                     	convertMainTempoMod mod
(2)  303/   E070A :                     	endm
(2)  304/   E070A :                     
(2)  305/   E070A :                     ; Header - Set up DAC Channel
(2)  306/   E070A :                     smpsHeaderDAC macro loc,pitch,vol
(2)  307/   E070A :                     	CheckedChannelPointer loc
(2)  308/   E070A :                     	if ("pitch"<>"")
(2)  309/   E070A :                     		dc.b	pitch
(2)  310/   E070A :                     		if ("vol"<>"")
(2)  311/   E070A :                     			dc.b	vol
(2)  312/   E070A :                     		else
(2)  313/   E070A :                     			dc.b	$00
(2)  314/   E070A :                     		endif
(2)  315/   E070A :                     	else
(2)  316/   E070A :                     		dc.w	$00
(2)  317/   E070A :                     	endif
(2)  318/   E070A :                     	endm
(2)  319/   E070A :                     
(2)  320/   E070A :                     ; Header - Set up FM Channel
(2)  321/   E070A :                     smpsHeaderFM macro loc,pitch,vol
(2)  322/   E070A :                     	CheckedChannelPointer loc
(2)  323/   E070A :                     	dc.b	pitch,vol
(2)  324/   E070A :                     	endm
(2)  325/   E070A :                     
(2)  326/   E070A :                     ; Header - Set up PSG Channel
(2)  327/   E070A :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  328/   E070A :                     	CheckedChannelPointer loc
(2)  329/   E070A :                     	PSGPitchConvert pitch
(2)  330/   E070A :                     	dc.b	vol
(2)  331/   E070A :                     	; Frequency envelope
(2)  332/   E070A :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  333/   E070A :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  334/   E070A :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  335/   E070A :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  336/   E070A :                     		dc.b	0
(2)  337/   E070A :                     	else
(2)  338/   E070A :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  339/   E070A :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  340/   E070A :                     		endif
(2)  341/   E070A :                     		dc.b	mod
(2)  342/   E070A :                     	endif
(2)  343/   E070A :                     	; Volume envelope
(2)  344/   E070A :                     	dc.b	voice
(2)  345/   E070A :                     	endm
(2)  346/   E070A :                     
(2)  347/   E070A :                     ; Header macros for SFX (not for music)
(2)  348/   E070A :                     ; Header - Set up Tempo
(2)  349/   E070A :                     smpsHeaderTempoSFX macro div
(2)  350/   E070A :                     	dc.b	div
(2)  351/   E070A :                     	endm
(2)  352/   E070A :                     
(2)  353/   E070A :                     ; Header - Set up Channel Usage
(2)  354/   E070A :                     smpsHeaderChanSFX macro chan
(2)  355/   E070A :                     	dc.b	chan
(2)  356/   E070A :                     	endm
(2)  357/   E070A :                     
(2)  358/   E070A :                     ; Header - Set up FM Channel
(2)  359/   E070A :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  360/   E070A :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  361/   E070A :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  362/   E070A :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  363/   E070A :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  364/   E070A :                     	endif
(2)  365/   E070A :                     	dc.b	$80,chanid
(2)  366/   E070A :                     	CheckedChannelPointer loc
(2)  367/   E070A :                     	if (chanid&$80)<>0
(2)  368/   E070A :                     		PSGPitchConvert pitch
(2)  369/   E070A :                     	else
(2)  370/   E070A :                     		dc.b	pitch
(2)  371/   E070A :                     	endif
(2)  372/   E070A :                     	dc.b	vol
(2)  373/   E070A :                     	endm
(2)  374/   E070A :                     ; ---------------------------------------------------------------------------
(2)  375/   E070A :                     ; Co-ord Flag Macros and Equates
(2)  376/   E070A :                     ; E0xx - Panning, AMS, FMS
(2)  377/   E070A :                     smpsPan macro direction,amsfms
(2)  378/   E070A :                     panNone set $00
(2)  379/   E070A :                     panRight set $40
(2)  380/   E070A :                     panLeft set $80
(2)  381/   E070A :                     panCentre set $C0
(2)  382/   E070A :                     panCenter set $C0 ; silly Americans :U
(2)  383/   E070A :                     	dc.b $E0,direction+amsfms
(2)  384/   E070A :                     	endm
(2)  385/   E070A :                     
(2)  386/   E070A :                     ; E1xx - Set channel detune to val
(2)  387/   E070A :                     smpsDetune macro val
(2)  388/   E070A :                     	dc.b	$E1,val
(2)  389/   E070A :                     	endm
(2)  390/   E070A :                     
(2)  391/   E070A :                     ; E2xx - Useless
(2)  392/   E070A :                     smpsNop macro val
(2)  393/   E070A :                     	if SonicDriverVer<3
(2)  394/   E070A :                     		dc.b	$E2,val
(2)  395/   E070A :                     	endif
(2)  396/   E070A :                     	endm
(2)  397/   E070A :                     
(2)  398/   E070A :                     ; Return (used after smpsCall)
(2)  399/   E070A :                     smpsReturn macro val
(2)  400/   E070A :                     	if SonicDriverVer>=3
(2)  401/   E070A :                     		dc.b	$F9
(2)  402/   E070A :                     	else
(2)  403/   E070A :                     		dc.b	$E3
(2)  404/   E070A :                     	endif
(2)  405/   E070A :                     	endm
(2)  406/   E070A :                     
(2)  407/   E070A :                     ; Fade in previous song (ie. 1-Up)
(2)  408/   E070A :                     smpsFade macro val
(2)  409/   E070A :                     	if SonicDriverVer>=3
(2)  410/   E070A :                     		dc.b	$E2
(2)  411/   E070A :                     		if ("val"<>"")
(2)  412/   E070A :                     			dc.b	val
(2)  413/   E070A :                     		else
(2)  414/   E070A :                     			dc.b	$FF
(2)  415/   E070A :                     		endif
(2)  416/   E070A :                     		if SourceDriver<3
(2)  417/   E070A :                     			smpsStop
(2)  418/   E070A :                     		endif
(2)  419/   E070A :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  420/   E070A :                     		; This is one of those weird S3+ "fades" that we don't need
(2)  421/   E070A :                     	else
(2)  422/   E070A :                     		dc.b	$E4
(2)  423/   E070A :                     	endif
(2)  424/   E070A :                     	endm
(2)  425/   E070A :                     
(2)  426/   E070A :                     ; E5xx - Set channel tempo divider to xx
(2)  427/   E070A :                     smpsChanTempoDiv macro val
(2)  428/   E070A :                     	if SonicDriverVer>=5
(2)  429/   E070A :                     		; New flag unique to Flamewing's modified S&K driver
(2)  430/   E070A :                     		dc.b	$FF,$08,val
(2)  431/   E070A :                     	elseif SonicDriverVer==3
(2)  432/   E070A :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  433/   E070A :                     	else
(2)  434/   E070A :                     		dc.b	$E5,val
(2)  435/   E070A :                     	endif
(2)  436/   E070A :                     	endm
(2)  437/   E070A :                     
(2)  438/   E070A :                     ; E6xx - Alter Volume by xx
(2)  439/   E070A :                     smpsAlterVol macro val
(2)  440/   E070A :                     	dc.b	$E6,val
(2)  441/   E070A :                     	endm
(2)  442/   E070A :                     
(2)  443/   E070A :                     ; E7 - Prevent attack of next note
(2)  444/   E070A : =$E7                 smpsNoAttack	EQU $E7
(2)  445/   E070A :                     
(2)  446/   E070A :                     ; E8xx - Set note fill to xx
(2)  447/   E070A :                     smpsNoteFill macro val
(2)  448/   E070A :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  449/   E070A :                     		; Unique to Flamewing's modified driver
(2)  450/   E070A :                     		dc.b	$FF,$0A,val
(2)  451/   E070A :                     	else
(2)  452/   E070A :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  453/   E070A :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  454/   E070A :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  455/   E070A :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  456/   E070A :                     		endif
(2)  457/   E070A :                     		dc.b	$E8,val
(2)  458/   E070A :                     	endif
(2)  459/   E070A :                     	endm
(2)  460/   E070A :                     
(2)  461/   E070A :                     ; Add xx to channel pitch
(2)  462/   E070A :                     smpsChangeTransposition macro val
(2)  463/   E070A :                     	if SonicDriverVer>=3
(2)  464/   E070A :                     		dc.b	$FB,val
(2)  465/   E070A :                     	else
(2)  466/   E070A :                     		dc.b	$E9,val
(2)  467/   E070A :                     	endif
(2)  468/   E070A :                     	endm
(2)  469/   E070A :                     
(2)  470/   E070A :                     ; Set music tempo modifier to xx
(2)  471/   E070A :                     smpsSetTempoMod macro mod
(2)  472/   E070A :                     	if SonicDriverVer>=3
(2)  473/   E070A :                     		dc.b	$FF,$00
(2)  474/   E070A :                     	else
(2)  475/   E070A :                     		dc.b	$EA
(2)  476/   E070A :                     	endif
(2)  477/   E070A :                     	convertMainTempoMod mod
(2)  478/   E070A :                     	endm
(2)  479/   E070A :                     
(2)  480/   E070A :                     ; Set music tempo divider to xx
(2)  481/   E070A :                     smpsSetTempoDiv macro val
(2)  482/   E070A :                     	if SonicDriverVer>=3
(2)  483/   E070A :                     		dc.b	$FF,$04,val
(2)  484/   E070A :                     	else
(2)  485/   E070A :                     		dc.b	$EB,val
(2)  486/   E070A :                     	endif
(2)  487/   E070A :                     	endm
(2)  488/   E070A :                     
(2)  489/   E070A :                     ; ECxx - Set Volume to xx
(2)  490/   E070A :                     smpsSetVol macro val
(2)  491/   E070A :                     	if SonicDriverVer>=3
(2)  492/   E070A :                     		dc.b	$E4,val
(2)  493/   E070A :                     	else
(2)  494/   E070A :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  495/   E070A :                     	endif
(2)  496/   E070A :                     	endm
(2)  497/   E070A :                     
(2)  498/   E070A :                     ; Works on all drivers
(2)  499/   E070A :                     smpsPSGAlterVol macro vol
(2)  500/   E070A :                     	dc.b	$EC,vol
(2)  501/   E070A :                     	endm
(2)  502/   E070A :                     
(2)  503/   E070A :                     smpsPSGAlterVolS2 macro vol
(2)  504/   E070A :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  505/   E070A :                     	if SonicDriverVer==2
(2)  506/   E070A :                     		smpsAlterVol vol
(2)  507/   E070A :                     	else
(2)  508/   E070A :                     		smpsPSGAlterVol vol
(2)  509/   E070A :                     	endif
(2)  510/   E070A :                     	endm
(2)  511/   E070A :                     
(2)  512/   E070A :                     ; Clears pushing sound flag in S1
(2)  513/   E070A :                     smpsClearPush macro
(2)  514/   E070A :                     	if SonicDriverVer==1
(2)  515/   E070A :                     		dc.b	$ED
(2)  516/   E070A :                     	else
(2)  517/   E070A :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  518/   E070A :                     	endif
(2)  519/   E070A :                     	endm
(2)  520/   E070A :                     
(2)  521/   E070A :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  522/   E070A :                     smpsStopSpecial macro
(2)  523/   E070A :                     	if SonicDriverVer==1
(2)  524/   E070A :                     		dc.b	$EE
(2)  525/   E070A :                     	else
(2)  526/   E070A :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  527/   E070A :                     		smpsStop
(2)  528/   E070A :                     	endif
(2)  529/   E070A :                     	endm
(2)  530/   E070A :                     
(2)  531/   E070A :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  532/   E070A :                     smpsFMvoice macro voice,songID
(2)  533/   E070A :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  534/   E070A :                     		dc.b	$EF,voice|$80,songID+$81
(2)  535/   E070A :                     	else
(2)  536/   E070A :                     		dc.b	$EF,voice
(2)  537/   E070A :                     	endif
(2)  538/   E070A :                     	endm
(2)  539/   E070A :                     
(2)  540/   E070A :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  541/   E070A :                     smpsModSet macro wait,speed,change,step
(2)  542/   E070A :                     	dc.b	$F0
(2)  543/   E070A :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  544/   E070A :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  545/   E070A :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  546/   E070A :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  547/   E070A :                     	else
(2)  548/   E070A :                     		dc.b	wait,speed,change,step
(2)  549/   E070A :                     	endif
(2)  550/   E070A :                     	;dc.b	speed,change,step
(2)  551/   E070A :                     	endm
(2)  552/   E070A :                     
(2)  553/   E070A :                     ; Turn on Modulation
(2)  554/   E070A :                     smpsModOn macro type
(2)  555/   E070A :                     	if SonicDriverVer>=3
(2)  556/   E070A :                     		if "type"<>""
(2)  557/   E070A :                     			dc.b	$F4,type
(2)  558/   E070A :                     		else
(2)  559/   E070A :                     			dc.b	$F4,$80
(2)  560/   E070A :                     		endif
(2)  561/   E070A :                     	else
(2)  562/   E070A :                     		dc.b	$F1
(2)  563/   E070A :                     	endif
(2)  564/   E070A :                     	endm
(2)  565/   E070A :                     
(2)  566/   E070A :                     ; F2 - End of channel
(2)  567/   E070A :                     smpsStop macro
(2)  568/   E070A :                     	dc.b	$F2
(2)  569/   E070A :                     	endm
(2)  570/   E070A :                     
