(2)  188/      B9 :                     zPlay_SegaPCM:
(2)  189/      B9 : 11 00 80            	ld	de,zmake68kPtr(SegaPCM)		; de = bank-relative location of the SEGA sound
(2)  190/      BC : 21 78 69            	ld	hl,SegaPCM_End-SegaPCM		; hl = size of the SEGA sound
(2)  191/      BF : 0E 2A               	ld	c,2Ah				; c = Command to select DAC output register
(2)  192/      C1 :                     
(2)  193/      C1 :                     zPlaySEGAPCMLoop:
(2)  194/      C1 : 1A                  	ld	a,(de)			; 7	; a = next byte from SEGA PCM
(2)  195/      C2 : DD 71 00            	ld	(ix+0),c		; 19	; Select DAC output register
