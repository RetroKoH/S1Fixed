    1604/    316C :                     		include	"_incObj/sub CalcSine.asm"
(1)    1/    316C :                     ; ---------------------------------------------------------------------------
(1)    2/    316C :                     ; Subroutine calculate a sine
(1)    3/    316C :                     
(1)    4/    316C :                     ; input:
(1)    5/    316C :                     ;	d0 = angle
(1)    6/    316C :                     
(1)    7/    316C :                     ; output:
(1)    8/    316C :                     ;	d0 = sine
(1)    9/    316C :                     ;	d1 = cosine
(1)   10/    316C :                     ; ---------------------------------------------------------------------------
(1)   11/    316C :                     
(1)   12/    316C :                     ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
(1)   13/    316C :                     
(1)   14/    316C :                     
(1)   15/    316C :                     CalcSine:
(1)   16/    316C : 0240 00FF           		andi.w	#$FF,d0
(1)   17/    3170 : D040                		add.w	d0,d0
(1)   18/    3172 : 0640 0080           		addi.w	#$80,d0
(1)   19/    3176 : 323B 000C           		move.w	Sine_Data(pc,d0.w),d1
(1)   20/    317A : 0440 0080           		subi.w	#$80,d0
(1)   21/    317E : 303B 0004           		move.w	Sine_Data(pc,d0.w),d0
(1)   22/    3182 : 4E75                		rts	
(1)   23/    3184 :                     ; End of function CalcSine
