    4495/    8618 :                     		; Floor the coordinates to the nearest pair of tiles (the size of a block).
    4496/    8618 :                     		; Also note that this wraps the value to the size of the plane:
    4497/    8618 :                     		; The plane is 64*8 wide, so wrap at $100, and it's 32*8 tall, so wrap at $200
    4498/    8618 : 0244 00F0           		andi.w	#$F0,d4
    4499/    861C : 0245 01F0           		andi.w	#$1F0,d5
    4500/    8620 :                     		; Transform the adjusted coordinates into a VDP command
    4501/    8620 : E94C                		lsl.w	#4,d4
    4502/    8622 : E44D                		lsr.w	#2,d5
    4503/    8624 : D845                		add.w	d5,d4
    4504/    8626 : 7003                		moveq	#3,d0	; Highest bits of plane VRAM address
    4505/    8628 : 4840                		swap	d0
    4506/    862A : 3004                		move.w	d4,d0
    4507/    862C : 4E75                		rts	
    4508/    862E :                     ; End of function Calc_VRAM_Pos
