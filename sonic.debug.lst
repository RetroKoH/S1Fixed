(1)   29/   EE978 :                     
(1)   29/   EE978 :                             ; Parse "BUS ERROR" itself
(1)   29/   EE978 :                             while (.__pos>=0)
(1)   29/   EE978 :                     
(1)   29/   EE978 :                             ; Find the last occurance "%<" in the "BUS ERROR"
(1)   29/   EE978 :                             while ( strstr(substr(.__str,.__pos+2,0),"%<")>=0 )
(1)   29/   EE978 :                                             .__pos:         set             strstr(substr(.__str,.__pos+2,0),"%<")+.__pos+2
(1)   29/   EE978 :                                     endm
(1)   29/   EE978 :                                     .__substr:      set             substr(.__str,.__pos,0)
(1)   29/   EE978 :                     
(1)   29/   EE978 :                                     ; Retrive expression in brackets following % char
(1)   29/   EE978 :                             .__endpos:      set             strstr(.__substr,">")
(1)   29/   EE978 :                                     if (.__endpos<0) ; Fix bizzare AS bug as stsstr() fails to check the last character of "BUS ERROR"
(1)   29/   EE978 :                                             .__endpos:      set             strlen(.__substr)-1
(1)   29/   EE978 :                                     endif
(1)   29/   EE978 :                             .__midpos:      set             strstr(substr(.__substr,5,0)," ")
(1)   29/   EE978 :                             if ((.__midpos<0)||(.__midpos+5>.__endpos))
(1)   29/   EE978 :                                             .__midpos:      set             .__endpos
(1)   29/   EE978 :                                     else
(1)   29/   EE978 :                                             .__midpos:      set             .__midpos+5
(1)   29/   EE978 :                             endif
(1)   29/   EE978 :                                     .__type:                set             substr(.__substr,2,2)   ; .type
(1)   29/   EE978 :                     
(1)   29/   EE978 :                                     ; Expression is an effective address (e.g. %(.w d0 hex) )
(1)   29/   EE978 :                                     if ((strlen(.__type)==2)&&(substr(.__type,0,1)=="."))
(1)   29/   EE978 :                                             .__operand:     set             substr(.__substr,5,.__midpos-5)                                         ; ea
(1)   29/   EE978 :                                             .__param:       set             substr(.__substr,.__midpos+1,.__endpos-.__midpos-1)             ; param
(1)   29/   EE978 :                     
(1)   29/   EE978 :                                             if (.__type==".b")
(1)   29/   EE978 :                                                     subq.w  #2, sp
(1)   29/   EE978 :                                                     __FSTRING_PushArgument.b        .__operand,1(sp)
(1)   29/   EE978 :                                                     .__sp:  set             .__sp+2
(1)   29/   EE978 :                     
(1)   29/   EE978 :                                             elseif (.__type==".w")
(1)   29/   EE978 :                                                     __FSTRING_PushArgument.w        .__operand,-(sp)
(1)   29/   EE978 :                                                     .__sp:  set             .__sp+2
(1)   29/   EE978 :                     
