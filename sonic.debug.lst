     239/     2CA :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     241/     2CA :                         save
     242/     2CA :                         CPU Z80 ; start assembling Z80 code
     243/       0 :                         phase 0 ; pretend we're at address 0
     244/       0 : AF                  	xor	a	; clear a to 0
     245/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     246/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     247/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     248/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     249/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     250/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     251/       E : DD E1               	pop	ix	; clear ix
     252/      10 : FD E1               	pop	iy	; clear iy
     253/      12 : ED 47               	ld	i,a	; clear i
     254/      14 : ED 4F               	ld	r,a	; clear r
     255/      16 : D1                  	pop	de	; clear de
     256/      17 : E1                  	pop	hl	; clear hl
     257/      18 : F1                  	pop	af	; clear af
     258/      19 : 08                  	ex	af,af'	; swap af with af'
     259/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     260/      1B : C1                  	pop	bc	; clear bc
     261/      1C : D1                  	pop	de	; clear de
     262/      1D : E1                  	pop	hl	; clear hl
     263/      1E : F1                  	pop	af	; clear af
     264/      1F : F9                  	ld	sp,hl	; clear sp
     265/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     266/      21 : ED 56               	im	1	; interrupt handling mode = 1
     267/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     268/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
