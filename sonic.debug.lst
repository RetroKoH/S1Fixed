(1)    1/   DD982 :                     ; ---------------------------------------------------------------------------
(1)    2/   DD982 :                     ; Modified SMPS 68k Type 1b sound driver
(1)    3/   DD982 :                     ; The source code to a similar version of the driver can be found here:
(1)    4/   DD982 :                     ; https://hiddenpalace.org/News/Sega_of_Japan_Sound_Documents_and_Source_Code
(1)    5/   DD982 :                     ; ---------------------------------------------------------------------------
(1)    6/   DD982 :                     ; Constants
(1)    7/   DD982 : =$12                 SMPS_TRACK_COUNT = (SMPS_RAM.v_track_ram_end-SMPS_RAM.v_track_ram)/SMPS_Track.len
(1)    8/   DD982 : =$A                  SMPS_MUSIC_TRACK_COUNT = (SMPS_RAM.v_music_track_ram_end-SMPS_RAM.v_music_track_ram)/SMPS_Track.len
(1)    9/   DD982 : =$7                  SMPS_MUSIC_FM_DAC_TRACK_COUNT = (SMPS_RAM.v_music_fmdac_tracks_end-SMPS_RAM.v_music_fmdac_tracks)/SMPS_Track.len
(1)   10/   DD982 : =$6                  SMPS_MUSIC_FM_TRACK_COUNT = (SMPS_RAM.v_music_fm_tracks_end-SMPS_RAM.v_music_fm_tracks)/SMPS_Track.len
(1)   11/   DD982 : =$3                  SMPS_MUSIC_PSG_TRACK_COUNT = (SMPS_RAM.v_music_psg_tracks_end-SMPS_RAM.v_music_psg_tracks)/SMPS_Track.len
(1)   12/   DD982 : =$6                  SMPS_SFX_TRACK_COUNT = (SMPS_RAM.v_sfx_track_ram_end-SMPS_RAM.v_sfx_track_ram)/SMPS_Track.len
(1)   13/   DD982 : =$3                  SMPS_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_sfx_fm_tracks_end-SMPS_RAM.v_sfx_fm_tracks)/SMPS_Track.len
(1)   14/   DD982 : =$3                  SMPS_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_sfx_psg_tracks_end-SMPS_RAM.v_sfx_psg_tracks)/SMPS_Track.len
(1)   15/   DD982 : =$2                  SMPS_SPECIAL_SFX_TRACK_COUNT = (SMPS_RAM.v_spcsfx_track_ram_end-SMPS_RAM.v_spcsfx_track_ram)/SMPS_Track.len
(1)   16/   DD982 : =$1                  SMPS_SPECIAL_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_spcsfx_fm_tracks_end-SMPS_RAM.v_spcsfx_fm_tracks)/SMPS_Track.len
(1)   17/   DD982 : =$1                  SMPS_SPECIAL_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_spcsfx_psg_tracks_end-SMPS_RAM.v_spcsfx_psg_tracks)/SMPS_Track.len
