(1)    2/   172BE :                     ; Subroutine to	find the floor
(1)    3/   172BE :                     
(1)    4/   172BE :                     ; input:
(1)    5/   172BE :                     ;	d2 = y-position of object's bottom edge
(1)    6/   172BE :                     ;	d3 = x-position of object
