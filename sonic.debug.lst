(1)    1/    143E :                     ; ---------------------------------------------------------------------------
(1)    2/    143E :                     ; MACRO ResetDMAQueue
(1)    3/    143E :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    143E :                     ; ---------------------------------------------------------------------------
(1)    5/    143E :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    143E :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    143E :                     ;
(1)    8/    143E :                     ; Output:
(1)    9/    143E :                     ; 	a1,a5	trashed
(1)   10/    143E :                     ; ---------------------------------------------------------------------------
(1)   11/    143E :                     ; ROUTINE InitDMAQueue
(1)   12/    143E :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    143E :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    143E :                     ; write to this region of RAM.
(1)   15/    143E :                     ;
(1)   16/    143E :                     ; Output:
(1)   17/    143E :                     ; 	a0,d0,d1	trashed
(1)   18/    143E :                     ; ---------------------------------------------------------------------------
(1)   19/    143E :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    143E :                     ; Queues a DMA with parameters given in registers.
(1)   21/    143E :                     ;
(1)   22/    143E :                     ; Options:
(1)   23/    143E :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    143E :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    143E :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    143E :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    143E :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    143E :                     ; Input:
(1)   29/    143E :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    143E :                     ; 		set to 0)
(1)   31/    143E :                     ; 	d2	Destination address
(1)   32/    143E :                     ; 	d3	Transfer length (in words)
(1)   33/    143E :                     ; Output:
(1)   34/    143E :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    143E :                     ;
(1)   36/    143E :                     ; With the default settings, runs in:
(1)   37/    143E :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    143E :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    143E :                     ;
(1)   40/    143E :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    143E :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    143E :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    143E :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    143E :                     ;   fills the queue (second piece is discarded)
(1)   45/    143E :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    143E :                     ;   space for both pieces (both pieces queued)
(1)   47/    143E :                     ;
(1)   48/    143E :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    143E :                     ;
(1)   50/    143E :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    143E :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    143E :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    143E :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    143E :                     ;
(1)   55/    143E :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    143E :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    143E :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    143E :                     ; in the correct form.
(1)   59/    143E :                     ; ---------------------------------------------------------------------------
(1)   60/    143E :                     ; MACRO QueueStaticDMA
(1)   61/    143E :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    143E :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    143E :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    143E :                     ;
(1)   65/    143E :                     ; The destination parameter can be either:
(1)   66/    143E :                     ; * a VRAM address literal;
(1)   67/    143E :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    143E :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    143E :                     ;
(1)   70/    143E :                     ; Options:
(1)   71/    143E :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    143E :                     ; Input:
(1)   73/    143E :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    143E :                     ; Output:
(1)   75/    143E :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    143E :                     ;
(1)   77/    143E :                     ; With the default settings, runs in:
(1)   78/    143E :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    143E :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    143E :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    143E :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    143E :                     ;
(1)   83/    143E :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    143E :                     ; ===========================================================================
(1)   85/    143E :                     ; option: AssumeSourceAddressInBytes
(1)   86/    143E :                     ;
(1)   87/    143E :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    143E :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    143E :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    143E : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    143E :                     ; ===========================================================================
(1)   92/    143E :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    143E :                     ;
(1)   94/    143E :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    143E :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    143E :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    143E :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    143E : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    143E :                     ; ===========================================================================
(1)  100/    143E :                     ; option: UseRAMSourceSafeDMA
(1)  101/    143E :                     ;
(1)  102/    143E :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    143E :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    143E :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    143E : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    143E :                     ; ===========================================================================
(1)  107/    143E :                     ; option: Use128kbSafeDMA
(1)  108/    143E :                     ;
(1)  109/    143E :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    143E :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    143E :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    143E :                     ; the job in situations where you can't align it in ROM.
(1)  113/    143E : =$0                  Use128kbSafeDMA = 0
(1)  114/    143E :                     ; ===========================================================================
(1)  115/    143E :                     ; option UseVIntSafeDMA
(1)  116/    143E :                     ;
(1)  117/    143E :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    143E :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    143E :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    143E :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    143E :                     ; restore interrupts after.
(1)  122/    143E : =$0                  UseVIntSafeDMA = 0
(1)  123/    143E :                     ; ===========================================================================
(1)  124/    143E :                     ; Convenience macros, for increased maintainability of the code.
(1)  126/    143E : =$27                 		equ	DMA,%100111
(1)  129/    143E : =$21                 		equ	VRAM,%100001
(1)  132/    143E :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    143E : =$1                  vdpCommReg_defined = 1
(1)  134/    143E :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    143E :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    143E :                     	set .upperbits,(type&rwd)&3
(1)  137/    143E :                     	if .upperbits<>0
(1)  138/    143E :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    143E :                     	endif
(1)  140/    143E :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    143E :                     	swap	reg								; Put all bits in proper places
(1)  142/    143E :                     	if clr <> 0
(1)  143/    143E :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    143E :                     	endif
(1)  145/    143E :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    143E :                     	if .lowerbits==$20
(1)  147/    143E :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    143E :                     	elseif .lowerbits<>0
(1)  149/    143E :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    143E :                     	endif
(1)  151/    143E :                     	endm
(1)  153/    143E :                     ; ---------------------------------------------------------------------------
(1)  155/    143E : =$1                  intMacros_defined = 1
(1)  156/    143E :                     enableInts macro
(1)  157/    143E :                     	move	#$2300,sr
(1)  158/    143E :                     	endm
(1)  159/    143E :                     
(1)  160/    143E :                     disableInts macro
(1)  161/    143E :                     	move	#$2700,sr
(1)  162/    143E :                     	endm
