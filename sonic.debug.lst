    1605/    3404 :                     		include	"_incObj/sub CalcAngle.asm"
(1)    1/    3404 :                     ; -------------------------------------------------------------------------
(1)    2/    3404 :                     ; 2-argument arctangent (angle between (0,0) and (x,y))
(1)    3/    3404 :                     ; Based on http://codebase64.org/doku.php?id=base:8bit_atan2_8-bit_angle
(1)    4/    3404 :                     ; -------------------------------------------------------------------------
(1)    5/    3404 :                     ; PARAMETERS:
(1)    6/    3404 :                     ;       d1.w - X value
(1)    7/    3404 :                     ;       d2.w - Y value
(1)    8/    3404 :                     ; RETURNS:
(1)    9/    3404 :                     ;       d0.b - 2-argument arctangent value (angle between (0,0) and (x,y))
(1)   10/    3404 :                     ; -------------------------------------------------------------------------
(1)   11/    3404 :                     
(1)   12/    3404 :                     CalcAngle:
(1)   13/    3404 : 7000                        moveq   #0,d0                           ; Default to bottom right quadrant
(1)   14/    3406 : 4A41                        tst.w   d1                              ; Is the X value negative?
(1)   15/    3408 : 6750                        beq.s   CalcAngle_XZero                 ; If the X value is zero, branch
(1)   16/    340A : 6A04                        bpl.s   CalcAngle_CheckY                ; If not, branch
(1)   17/    340C : 4641                        not.w   d1                              ; If so, get the absolute value
(1)   18/    340E : 7004                        moveq   #4,d0                           ; Shift to left quadrant
(1)   19/    3410 :                      
(1)   20/    3410 :                     CalcAngle_CheckY:
(1)   21/    3410 : 4A42                        tst.w   d2                              ; Is the Y value negative?
(1)   22/    3412 : 673E                        beq.s   CalcAngle_YZero                 ; If the Y value is zero, branch
(1)   23/    3414 : 6A04                        bpl.s   CalcAngle_CheckOctet            ; If not, branch
(1)   24/    3416 : 4642                        not.w   d2                              ; If so, get the absolute value
(1)   25/    3418 : 5400                        addq.b  #2,d0                           ; Shift to top quadrant
(1)   26/    341A :                     
(1)   27/    341A :                     CalcAngle_CheckOctet:
(1)   28/    341A : B242                        cmp.w   d2,d1                           ; Are we horizontally closer to the center?
(1)   29/    341C : 6404                        bcc.s   CalcAngle_Divide                ; If not, branch
(1)   30/    341E : C342                        exg.l   d1,d2                           ; If so, divide Y from X instead
(1)   31/    3420 : 5200                        addq.b  #1,d0                           ; Use octant that's horizontally closer to the center
(1)   32/    3422 :                      
(1)   33/    3422 :                     CalcAngle_Divide:
(1)   34/    3422 : 3F01                        move.w  d1,-(sp)                        ; Shrink X and Y down into bytes
(1)   35/    3424 : 7600                        moveq   #0,d3
(1)   36/    3426 : 161F                        move.b  (sp)+,d3
(1)   37/    3428 : 163B 3044                   move.b  WordShiftTable(pc,d3.w),d3
(1)   38/    342C : E669                        lsr.w   d3,d1
(1)   39/    342E : E66A                        lsr.w   d3,d2
(1)   40/    3430 :                     
(1)   41/    3430 : 45FA 00BC                   lea     Log2Table(pc),a2                ; Perform logarithmic division
(1)   42/    3434 : 1432 2000                   move.b  (a2,d2.w),d2
(1)   43/    3438 : 9432 1000                   sub.b   (a2,d1.w),d2
(1)   44/    343C : 6604                        bne.s   CalcAngle_GetAtan2Val
(1)   45/    343E : 343C 00FF                   move.w  #$FF,d2                         ; Edge case where X and Y values are too close for the division to handle
(1)   46/    3442 :                     
(1)   47/    3442 :                     CalcAngle_GetAtan2Val:
(1)   48/    3442 : 45FA 01AA                   lea     Atan2Table(pc),a2               ; Get atan2 value
(1)   49/    3446 : 1432 2000                   move.b  (a2,d2.w),d2
(1)   50/    344A : 103B 001A                   move.b  OctantAdjust(pc,d0.w),d0
(1)   51/    344E : B500                        eor.b   d2,d0
(1)   52/    3450 : 4E75                        rts
(1)   53/    3452 :                     
(1)   54/    3452 :                     ; -------------------------------------------------------------------------
(1)   55/    3452 :                     
(1)   56/    3452 :                     CalcAngle_YZero:
(1)   57/    3452 : 4A00                        tst.b   d0                              ; Was the X value negated?
(1)   58/    3454 : 6702                        beq.s   CalcAngle_End                   ; If not, branch (d0 is already 0, so no need to set it again on branch)
(1)   59/    3456 : 7080                        moveq   #$FFFFFF80,d0                   ; 180 degrees
(1)   60/    3458 :                     
(1)   61/    3458 :                     CalcAngle_End:
(1)   62/    3458 : 4E75                        rts
(1)   63/    345A :                     
(1)   64/    345A :                     CalcAngle_XZero:
(1)   65/    345A : 4A42                        tst.w   d2                              ; Is the Y value negative?
(1)   66/    345C : 6B04                        bmi.s   CalcAngle_XZeroYNeg             ; If so, branch
(1)   67/    345E : 7040                        moveq   #$40,d0                         ; 90 degrees
(1)   68/    3460 : 4E75                        rts
(1)   69/    3462 :                     
(1)   70/    3462 :                     CalcAngle_XZeroYNeg:
(1)   71/    3462 : 70C0                        moveq   #$FFFFFFC0,d0                   ; 270 degrees
(1)   72/    3464 : 4E75                        rts
(1)   73/    3466 :                      
(1)   74/    3466 :                     ; -------------------------------------------------------------------------
