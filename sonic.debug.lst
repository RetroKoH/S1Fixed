(1)    2/   150B6 :                     ; Sonic	graphics loading subroutine (Mercury Use DMA Queue)
(1)    3/   150B6 :                     ; ---------------------------------------------------------------------------
(1)    4/   150B6 :                     
(1)    5/   150B6 :                     ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
(1)    6/   150B6 :                     
(1)    7/   150B6 :                     
(1)    8/   150B6 :                     Sonic_LoadGfx:
(1)    9/   150B6 : 7000                		moveq	#0,d0
(1)   10/   150B8 : 1028 001A           		move.b	obFrame(a0),d0			; d0 = Sonic's current frame number
(1)   11/   150BC : B038 F766           		cmp.b	(v_sonframenum).w,d0	; has frame changed?
(1)   12/   150C0 : 6744                		beq.s	.nochange				; if not, branch and exit
(1)   13/   150C2 :                     
(1)   14/   150C2 : 11C0 F766           		move.b	d0,(v_sonframenum).w	; update frame number for next check
(1)   15/   150C6 : 45FA 0040           		lea		SonicDynPLC(pc),a2		; a2 = PLC script
(1)   16/   150CA : D040                		add.w	d0,d0					; multiply current frame number by 2
(1)   17/   150CC : D4F2 0000           		adda.w	(a2,d0.w),a2			; a2 = corresponding PLC
(1)   18/   150D0 : 7A00                		moveq	#0,d5
(1)   19/   150D2 : 3A1A                		move.w	(a2)+,d5				; read "number of PLC entries" value						; S3K Changed from .b to .w
(1)   20/   150D4 : 5345                		subq.w	#1,d5					; decrement for .readentry loop
(1)   21/   150D6 : 6B2E                		bmi.s	.nochange				; if there are no entries, branch and exit
(1)   22/   150D8 : 383C F000           		move.w	#(ArtTile_Sonic*$20),d4	; d4 = Sonic's VRAM location
(1)   23/   150DC :                     
(1)   24/   150DC :                     .readentry:
(1)   25/   150DC : 7200                		moveq	#0,d1
(1)   26/   150DE : 321A                		move.w	(a2)+,d1				; d1 = (number of tiles to load - 1)*$10; aka "tile count"	; S3K Changed from .b to .w
(1)   27/   150E0 : 3601                		move.w	d1,d3
(1)   28/   150E2 : E04B                		lsr.w	#8,d3					; d3 = (tile count-1)*$10
(1)   29/   150E4 : 0243 00F0           		andi.w	#$F0,d3
(1)   30/   150E8 : 0643 0010           		addi.w	#$10,d3					; get actual tile count*$10				-- DMATransfer Length
(1)   31/   150EC : 0241 0FFF           		andi.w	#$FFF,d1				; clear the counter to remove tile count from the far left nybble
(1)   32/   150F0 : EB89                		lsl.l	#5,d1					; changed to .l (allows for more than $FFFF bytes)
(1)   33/   150F2 : D2BC 0002 443E      		add.l	#Art_Sonic,d1			; d1 = (Sonic's art file + tile offset)	-- DMATransfer Source
(1)   34/   150F8 : 3404                		move.w	d4,d2					; d2 = Sonic's VRAM location			-- DMATransfer Destination
(1)   35/   150FA : D843                		add.w	d3,d4
(1)   36/   150FC : D843                		add.w	d3,d4					; d4 = Sonic's VRAM loc + (tile count * 2)
(1)   37/   150FE : 4EB8 143E           		jsr		(QueueDMATransfer).w
(1)   38/   15102 : 51CD FFD8           		dbf		d5,.readentry			; repeat for number of entries
(1)   39/   15106 :                     
(1)   40/   15106 :                     .nochange:
(1)   41/   15106 : 4E75                		rts	
