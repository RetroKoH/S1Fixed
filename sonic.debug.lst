(2)  588/   E070A :                     	endm
(2)  589/   E070A :                     
(2)  590/   E070A :                     ; F6xxxx - Jump to xxxx
(2)  591/   E070A :                     smpsJump macro loc
(2)  592/   E070A :                     	dc.b	$F6
(2)  593/   E070A :                     	if SonicDriverVer<>1
(2)  594/   E070A :                     		dc.w	z80_ptr(loc)
(2)  595/   E070A :                     	else
(2)  596/   E070A :                     		dc.w	loc-*-1
(2)  597/   E070A :                     	endif
(2)  598/   E070A :                     	endm
(2)  599/   E070A :                     
(2)  600/   E070A :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  601/   E070A :                     smpsLoop macro index,loops,loc
(2)  602/   E070A :                     	dc.b	$F7
(2)  603/   E070A :                     	dc.b	index,loops
(2)  604/   E070A :                     	if SonicDriverVer<>1
(2)  605/   E070A :                     		dc.w	z80_ptr(loc)
(2)  606/   E070A :                     	else
(2)  607/   E070A :                     		dc.w	loc-*-1
(2)  608/   E070A :                     	endif
(2)  609/   E070A :                     	endm
(2)  610/   E070A :                     
(2)  611/   E070A :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  612/   E070A :                     smpsCall macro loc
(2)  613/   E070A :                     	dc.b	$F8
(2)  614/   E070A :                     	if SonicDriverVer<>1
(2)  615/   E070A :                     		dc.w	z80_ptr(loc)
(2)  616/   E070A :                     	else
(2)  617/   E070A :                     		dc.w	loc-*-1
(2)  618/   E070A :                     	endif
(2)  619/   E070A :                     	endm
