    4640/    8778 :                     
    4642/    8778 : 0C78 0103 FD50      		cmpi.w	#(id_LZ<<8)+3,(v_zone).w	; is level SBZ3 (LZ4) ?
    4643/    877E : 6602                		bne.s	.notSBZ3Art					; if not, branch
    4644/    8780 : 7007                		moveq	#SBZ3_Art,d0				; use SBZ3 art
    4645/    8782 :                     
    4646/    8782 :                     .notSBZ3Art:
    4648/    8782 :                     
    4649/    8782 : E948                		lsl.w	#4,d0						; Multiply by $10, converting the zone ID into an offset
    4650/    8784 : 45F9 0002 01AA      		lea		(LevelHeaders).l,a2			; a2 = LevelHeaders address
    4651/    878A : 45F2 0000           		lea		(a2,d0.w),a2				; a2 = LevelHeaders + zone offset
    4652/    878E : 2F0A                		move.l	a2,-(sp)					; store LevelHeader location for future use (Data Load)
    4653/    8790 :                     
    4654/    8790 : 201A                		move.l	(a2)+,d0					; d0 = 1st longword of data that a2 points to, (zone's first PLC ID and art address).
    4655/    8792 :                     	; The auto increment was pointless as a2 is overwritten later, and nothing reads from a2 before then
    4656/    8792 : 0280 00FF FFFF      		andi.l	#$FFFFFF,d0					; Filter out the high byte, which contains the first PLC ID, leaving the address of the zone's art in d0
    4657/    8798 : 2040                		movea.l	d0,a0						; a0 = address of the zone's art (SOURCE)
    4658/    879A : 43F9 FFFF 0000      		lea		(v_ram_start).l,a1			; a1 = StartOfRAM (in this context, an art buffer) (DESTINATION)
    4659/    87A0 : 6100 9396           		bsr.w	KosDec						; Decompress a0 to a1 (Switch to Comper compression??)
    4660/    87A4 :                     
    4661/    87A4 :                     	; Move a word of a1 to d3, note that a1 doesn't exactly contain the address of v_128x128/StartOfRAM anymore, after KosDec, a1 now contains v_128x128/StartOfRAM + the size of the file decompressed to it, d3 now contains the length of the file that was decompressed
    4662/    87A4 : 3609                		move.w	a1,d3
    4663/    87A6 : 3E03                		move.w	d3,d7						; Move d3 to d7, for use in seperate calculations
    4664/    87A8 : 0243 0FFF           		andi.w	#$FFF,d3					; Remove the high nibble of the high byte of the length of decompressed file, this nibble is how many $1000 bytes the decompressed art is
    4665/    87AC : E24B                		lsr.w	#1,d3						; Half the value of 'length of decompressed file', d3 becomes the 'DMA transfer length'
    4666/    87AE : E95F                		rol.w	#4,d7						; Rotate (left) length of decompressed file by one nibble
    4667/    87B0 : 0247 000F           		andi.w	#$F,d7						; Only keep the low nibble of low byte (the same one filtered out of d3 above), this nibble is how many $1000 bytes the decompressed art is
    4668/    87B4 :                      
    4669/    87B4 :                     .loop:
    4670/    87B4 : 3407                		move.w	d7,d2						; Move d7 to d2, note that the ahead dbf removes 1 byte from d7 each time it loops, meaning that the following calculations will have different results each time
    4671/    87B6 : 700C                		moveq	#12,d0
    4672/    87B8 : E16A                		lsl.w	d0,d2						; Shift (left) d2 by $C, making it high nibble of the high byte, d2 is now the size of the decompressed file rounded down to the nearest $1000 bytes, d2 becomes the 'destination address'
    4673/    87BA : 223C 00FF FFFF      		move.l	#$FFFFFF,d1					; Fill d1 with $FF
    4674/    87C0 : 3202                		move.w	d2,d1						; Move d2 to d1, overwriting the last word of $FF's with d2, this turns d1 into 'StartOfRAM'+'However many $1000 bytes the decompressed art is', d1 becomes the 'source address'
    4675/    87C2 : 4EB8 143E           		jsr		(QueueDMATransfer).w		; Use d1, d2, and d3 to locate the decompressed art and ready for transfer to VRAM
    4676/    87C6 : 3F07                		move.w	d7,-(sp)					; Store d7 in the Stack
    4677/    87C8 : 11FC 000C F62A      		move.b	#$C,(v_vbla_routine).w
    4678/    87CE : 6100 A96A           		bsr.w	WaitForVBla
    4679/    87D2 : 6100 90AE           		bsr.w	RunPLC
    4680/    87D6 : 3E1F                		move.w	(sp)+,d7					; Restore d7 from the Stack
    4681/    87D8 : 363C 0800           		move.w	#$800,d3					; Force the DMA transfer length to be $1000/2 (the first cycle is dynamic because the art's DMA'd backwards)
    4682/    87DC : 51CF FFD6           		dbf		d7,.loop					; Loop for each $1000 bytes the decompressed art is
