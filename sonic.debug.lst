    5968/   1760C :                     ; ---------------------------------------------------------------------------
    5969/   1760C :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    5970/   1760C :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    5971/   1760C :                     ; Pointers to said raw data are dummied out.
    5972/   1760C :                     ; Curiously, an example of the original 'raw' data that this was intended
    5973/   1760C :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    5974/   1760C :                     ; ---------------------------------------------------------------------------
    5975/   1760C :                     
    5976/   1760C : =$C552C              RawColBlocks		equ CollArray1
    5977/   1760C : =$C552C              ConvRowColBlocks	equ CollArray1
    5978/   1760C :                     
    5979/   1760C :                     ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
    5980/   1760C :                     
    5981/   1760C :                     
    5982/   1760C :                     ConvertCollisionArray:
    5983/   1760C : 4E75                		rts	
    5984/   1760E :                     ; ---------------------------------------------------------------------------
    5985/   1760E :                     		; The raw format stores the collision data column by column for the normal collision array.
    5986/   1760E :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    5987/   1760E : 43F9 000C 552C      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
    5988/   17614 : 45F9 000C 552C      		lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
    5989/   1761A :                     
    5990/   1761A : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
    5991/   1761E :                     
    5992/   1761E :                     .blockLoop:
    5993/   1761E : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    5994/   17620 :                     
    5995/   17620 : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    5996/   17624 :                     
    5997/   17624 :                     .columnLoop:
    5998/   17624 : 7800                		moveq	#0,d4
    5999/   17626 :                     
    6000/   17626 : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
    6001/   1762A :                     
    6002/   1762A :                     .rowLoop:
    6003/   1762A : 3019                		move.w	(a1)+,d0		; Get row of collision bits
    6004/   1762C : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    6005/   1762E : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    6006/   17630 : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    6007/   17634 :                     
    6008/   17634 : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    6009/   17636 : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    6010/   1763A : 5345                		subq.w	#1,d5			; Get next bit in the row
    6011/   1763C : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    6012/   17640 :                     
    6013/   17640 : D2FC 0020           		adda.w	#2*16,a1		; Next block
    6014/   17644 : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
    6015/   17648 :                     
    6016/   17648 :                     		; This then converts the collision data into the final collision arrays
    6017/   17648 : 43F9 000C 552C      		lea	(ConvRowColBlocks).l,a1
    6018/   1764E : 45F9 000C 652C      		lea	(CollArray2).l,a2	; Convert the row-converted collision block data into final rotated collision array
    6019/   17654 : 610C                		bsr.s	.convertArray
    6020/   17656 : 43F9 000C 552C      		lea	(RawColBlocks).l,a1
    6021/   1765C : 45F9 000C 552C      		lea	(CollArray1).l,a2	; Convert the raw collision block data into final normal collision array
    6022/   17662 :                     
    6023/   17662 :                     
    6024/   17662 :                     .convertArray:
    6025/   17662 : 363C 0FFF           		move.w	#$1000-1,d3		; Size of the collision array
    6026/   17666 :                     
    6027/   17666 :                     .processLoop:
    6028/   17666 : 7400                		moveq	#0,d2
    6029/   17668 : 323C 000F           		move.w	#$F,d1
    6030/   1766C : 3019                		move.w	(a1)+,d0		; Get current column of collision pixels
    6031/   1766E : 6724                		beq.s	.noCollision		; Branch if there's no collision in this column
    6032/   17670 : 6B0C                		bmi.s	.topPixelSolid		; Branch if top pixel of collision is solid
    6033/   17672 :                     
    6034/   17672 :                     	; Here we count, starting from the bottom, how many pixels tall
    6035/   17672 :                     	; the collision in this column is.
    6036/   17672 :                     .processColumnLoop1:
    6037/   17672 : E248                		lsr.w	#1,d0
    6038/   17674 : 6402                		bhs.s	.pixelNotSolid1
    6039/   17676 : 5202                		addq.b	#1,d2
    6040/   17678 :                     
    6041/   17678 :                     .pixelNotSolid1:
    6042/   17678 : 51C9 FFF8           		dbf	d1,.processColumnLoop1
    6043/   1767C :                     
    6044/   1767C : 6018                		bra.s	.columnProcessed
    6045/   1767E :                     ; ===========================================================================
    6046/   1767E :                     
    6047/   1767E :                     .topPixelSolid:
    6048/   1767E : 0C40 FFFF           		cmpi.w	#$FFFF,d0		; Is entire column solid?
    6049/   17682 : 670C                		beq.s	.entireColumnSolid	; Branch if so
    6050/   17684 :                     
    6051/   17684 :                     	; Here we count, starting from the top, how many pixels tall
    6052/   17684 :                     	; the collision in this column is (the resulting number is negative).
    6053/   17684 :                     .processColumnLoop2:
    6054/   17684 : E348                		lsl.w	#1,d0
    6055/   17686 : 6402                		bhs.s	.pixelNotSolid2
    6056/   17688 : 5302                		subq.b	#1,d2
    6057/   1768A :                     
    6058/   1768A :                     .pixelNotSolid2:
    6059/   1768A : 51C9 FFF8           		dbf	d1,.processColumnLoop2
    6060/   1768E :                     
    6061/   1768E : 6006                		bra.s	.columnProcessed
    6062/   17690 :                     ; ===========================================================================
    6063/   17690 :                     
    6064/   17690 :                     .entireColumnSolid:
    6065/   17690 : 303C 0010           		move.w	#$10,d0
    6066/   17694 :                     
    6067/   17694 :                     .noCollision:
    6068/   17694 : 3400                		move.w	d0,d2
    6069/   17696 :                     
    6070/   17696 :                     .columnProcessed:
    6071/   17696 : 14C2                		move.b	d2,(a2)+		; Store column collision height
    6072/   17698 : 51CB FFCC           		dbf	d3,.processLoop
    6073/   1769C :                     
    6074/   1769C : 4E75                		rts	
    6075/   1769E :                     
    6076/   1769E :                     ; End of function ConvertCollisionArray
    6077/   1769E :                     
    6078/   1769E :                     
    6079/   1769E :                     ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
    6080/   1769E :                     
    6081/   1769E :                     
    6082/   1769E :                     Sonic_WalkSpeed:
    6083/   1769E : 21FC 00FF 9000      		move.l	#v_collision1&$FFFFFF,(v_collindex).w	; MJ: load first collision data location
            176A4 : F796             
    6084/   176A6 : 0C38 000C FF06      		cmpi.b	#$C,(v_top_solid_bit).w					; MJ: is second collision set to be used?
    6085/   176AC : 6708                		beq.s	.first									; MJ: if not, branch
    6086/   176AE : 21FC 00FF 9300      		move.l	#v_collision2&$FFFFFF,(v_collindex).w	; MJ: load second collision data location
            176B4 : F796             
    6087/   176B6 :                     .first:
    6088/   176B6 : 1A38 FF07           		move.b	(v_lrb_solid_bit).w,d5					; MJ: load L/R/B soldity bit
    6089/   176BA : 2628 0008           		move.l	obX(a0),d3
    6090/   176BE : 2428 000C           		move.l	obY(a0),d2
    6091/   176C2 : 3228 0010           		move.w	obVelX(a0),d1
    6092/   176C6 : 48C1                		ext.l	d1
    6093/   176C8 : E181                		asl.l	#8,d1
    6094/   176CA : D681                		add.l	d1,d3
    6095/   176CC : 3228 0012           		move.w	obVelY(a0),d1
    6096/   176D0 : 48C1                		ext.l	d1
    6097/   176D2 : E181                		asl.l	#8,d1
    6098/   176D4 : D481                		add.l	d1,d2
    6099/   176D6 : 4842                		swap	d2
    6100/   176D8 : 4843                		swap	d3
