(2)  769/   E070A :                     ; Macros for FM instruments
(2)  770/   E070A :                     ; Voices - Feedback
(2)  771/   E070A :                     smpsVcFeedback macro val
(2)  772/   E070A :                     vcFeedback set val
(2)  773/   E070A :                     	endm
(2)  774/   E070A :                     
(2)  775/   E070A :                     ; Voices - Algorithm
(2)  776/   E070A :                     smpsVcAlgorithm macro val
(2)  777/   E070A :                     vcAlgorithm set val
(2)  778/   E070A :                     	endm
(2)  779/   E070A :                     
(2)  780/   E070A :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  781/   E070A :                     vcUnusedBits set val
(2)  782/   E070A :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  783/   E070A :                     		set vcD1R1Unk,d1r1<<5
(2)  784/   E070A :                     		set vcD1R2Unk,d1r2<<5
(2)  785/   E070A :                     		set vcD1R3Unk,d1r3<<5
(2)  786/   E070A :                     		set vcD1R4Unk,d1r4<<5
(2)  787/   E070A :                     	else
(2)  788/   E070A :                     		set vcD1R1Unk,0
(2)  789/   E070A :                     		set vcD1R2Unk,0
(2)  790/   E070A :                     		set vcD1R3Unk,0
(2)  791/   E070A :                     		set vcD1R4Unk,0
(2)  792/   E070A :                     	endif
(2)  793/   E070A :                     	endm
(2)  794/   E070A :                     
(2)  795/   E070A :                     ; Voices - Detune
(2)  796/   E070A :                     smpsVcDetune macro op1,op2,op3,op4
(2)  797/   E070A :                     	set vcDT1,op1
(2)  798/   E070A :                     	set vcDT2,op2
(2)  799/   E070A :                     	set vcDT3,op3
(2)  800/   E070A :                     	set vcDT4,op4
(2)  801/   E070A :                     	endm
(2)  802/   E070A :                     
(2)  803/   E070A :                     ; Voices - Coarse-Frequency
(2)  804/   E070A :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  805/   E070A :                     	set vcCF1,op1
(2)  806/   E070A :                     	set vcCF2,op2
(2)  807/   E070A :                     	set vcCF3,op3
(2)  808/   E070A :                     	set vcCF4,op4
(2)  809/   E070A :                     	endm
(2)  810/   E070A :                     
(2)  811/   E070A :                     ; Voices - Rate Scale
(2)  812/   E070A :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  813/   E070A :                     	set vcRS1,op1
(2)  814/   E070A :                     	set vcRS2,op2
(2)  815/   E070A :                     	set vcRS3,op3
(2)  816/   E070A :                     	set vcRS4,op4
(2)  817/   E070A :                     	endm
(2)  818/   E070A :                     
(2)  819/   E070A :                     ; Voices - Attack Rate
(2)  820/   E070A :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  821/   E070A :                     	set vcAR1,op1
(2)  822/   E070A :                     	set vcAR2,op2
(2)  823/   E070A :                     	set vcAR3,op3
(2)  824/   E070A :                     	set vcAR4,op4
(2)  825/   E070A :                     	endm
(2)  826/   E070A :                     
(2)  827/   E070A :                     ; Voices - Amplitude Modulation
(2)  828/   E070A :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  829/   E070A :                     ; were the Amplitude Modulation.
(2)  830/   E070A :                     ; According to several docs, however, it's actually the high bit.
(2)  831/   E070A :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  832/   E070A :                     	if SourceSMPS2ASM==0
(2)  833/   E070A :                     		set vcAM1,op1<<5
(2)  834/   E070A :                     		set vcAM2,op2<<5
(2)  835/   E070A :                     		set vcAM3,op3<<5
(2)  836/   E070A :                     		set vcAM4,op4<<5
(2)  837/   E070A :                     	else
(2)  838/   E070A :                     		set vcAM1,op1<<7
(2)  839/   E070A :                     		set vcAM2,op2<<7
(2)  840/   E070A :                     		set vcAM3,op3<<7
(2)  841/   E070A :                     		set vcAM4,op4<<7
(2)  842/   E070A :                     	endif
(2)  843/   E070A :                     	endm
(2)  844/   E070A :                     
(2)  845/   E070A :                     ; Voices - First Decay Rate
(2)  846/   E070A :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  847/   E070A :                     	set vcD1R1,op1
(2)  848/   E070A :                     	set vcD1R2,op2
(2)  849/   E070A :                     	set vcD1R3,op3
(2)  850/   E070A :                     	set vcD1R4,op4
(2)  851/   E070A :                     	endm
(2)  852/   E070A :                     
(2)  853/   E070A :                     ; Voices - Second Decay Rate
(2)  854/   E070A :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  855/   E070A :                     	set vcD2R1,op1
(2)  856/   E070A :                     	set vcD2R2,op2
(2)  857/   E070A :                     	set vcD2R3,op3
(2)  858/   E070A :                     	set vcD2R4,op4
(2)  859/   E070A :                     	endm
(2)  860/   E070A :                     
(2)  861/   E070A :                     ; Voices - Decay Level
(2)  862/   E070A :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  863/   E070A :                     	set vcDL1,op1
(2)  864/   E070A :                     	set vcDL2,op2
(2)  865/   E070A :                     	set vcDL3,op3
(2)  866/   E070A :                     	set vcDL4,op4
(2)  867/   E070A :                     	endm
(2)  868/   E070A :                     
(2)  869/   E070A :                     ; Voices - Release Rate
(2)  870/   E070A :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  871/   E070A :                     	set vcRR1,op1
(2)  872/   E070A :                     	set vcRR2,op2
(2)  873/   E070A :                     	set vcRR3,op3
(2)  874/   E070A :                     	set vcRR4,op4
(2)  875/   E070A :                     	endm
(2)  876/   E070A :                     
(2)  877/   E070A :                     ; Voices - Total Level
(2)  878/   E070A :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  879/   E070A :                     ; but later versions leave it up to the user.
(2)  880/   E070A :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  881/   E070A :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  882/   E070A :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  883/   E070A :                     ; SMPS Z80 does the opposite.
(2)  884/   E070A :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  885/   E070A :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  886/   E070A :                     ; what we do, so we just print a warning.
(2)  887/   E070A :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  888/   E070A :                     	set vcTL1,op1
(2)  889/   E070A :                     	set vcTL2,op2
(2)  890/   E070A :                     	set vcTL3,op3
(2)  891/   E070A :                     	set vcTL4,op4
(2)  892/   E070A :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  893/   E070A :                     ;   0     1     2     3     4     5     6     7
(2)  894/   E070A :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  895/   E070A :                     	if SourceSMPS2ASM==0
(2)  896/   E070A :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  897/   E070A :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  898/   E070A :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  899/   E070A :                     		set vcTLMask1,$80
(2)  900/   E070A :                     	else
(2)  901/   E070A :                     		set vcTLMask4,0
(2)  902/   E070A :                     		set vcTLMask3,0
(2)  903/   E070A :                     		set vcTLMask2,0
(2)  904/   E070A :                     		set vcTLMask1,0
(2)  905/   E070A :                     	endif
(2)  906/   E070A :                     
(2)  907/   E070A :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  908/   E070A :                     		set vcTLMask4,((vcAlgorithm==7)<<7)
(2)  909/   E070A :                     		set vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  910/   E070A :                     		set vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  911/   E070A :                     		set vcTLMask1,$80
(2)  912/   E070A :                     		set vcTL1,vcTL1&$7F
(2)  913/   E070A :                     		set vcTL2,vcTL2&$7F
(2)  914/   E070A :                     		set vcTL3,vcTL3&$7F
(2)  915/   E070A :                     		set vcTL4,vcTL4&$7F
(2)  916/   E070A :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&$80)<>$80)||(((vcTL2|vcTLMask2)&$80)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&$80)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&$80)<>((vcAlgorithm==7)<<7)))
(2)  917/   E070A :                     		if MOMPASS=1
(2)  918/   E070A :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  919/   E070A :                     		endif
(2)  920/   E070A :                     	endif
(2)  921/   E070A :                     
(2)  922/   E070A :                     	if SonicDriverVer==2
(2)  923/   E070A :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  924/   E070A :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  925/   E070A :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  926/   E070A :                     		dc.b	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  927/   E070A :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  928/   E070A :                     		dc.b	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  929/   E070A :                     	else
(2)  930/   E070A :                     		dc.b	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  931/   E070A :                     		dc.b	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  932/   E070A :                     		dc.b	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  933/   E070A :                     		dc.b	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  934/   E070A :                     		dc.b	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  935/   E070A :                     		dc.b	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  936/   E070A :                     	endif
(2)  937/   E070A :                     	endm
(2)  938/   E070A :                     
(2)  939/   E070A :                     
