(1)    3/   1553C :                     ; Subroutine to collect the right speed setting for a character
(1)    4/   1553C :                     ; Originally by redhotsonic. Optimizations by MoDule.
(1)    5/   1553C :                     ;
(1)    6/   1553C :                     ; a0 must be character
(1)    7/   1553C :                     ; a1 will be the result and have the correct speed settings
(1)    8/   1553C :                     ; a2 is characters' speed
(1)    9/   1553C :                     ; ---------------------------------------------------------------------------
(1)   10/   1553C :                     
(1)   11/   1553C :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
(1)   12/   1553C :                     
(1)   13/   1553C :                     ApplySpeedSettings:
(1)   14/   1553C : 7000                		moveq   #0,d0								; Quickly clear d0
(1)   15/   1553E : 4A28 0032           		tst.b   obShoes(a0)							; Does character have speedshoes? -- RetroKoH Sonic SST Compaction
(1)   16/   15542 : 6702                		beq.s   .noshoes							; If not, branch
(1)   17/   15544 : 5000                		addq.b  #8,d0
(1)   18/   15546 :                     
(1)   19/   15546 :                     .noshoes:
(1)   20/   15546 : 0828 0006 0022      		btst    #staWater,obStatus(a0)				; Is the character underwater?
(1)   21/   1554C : 6704                		beq.s   .nowater							; If not, branch
(1)   22/   1554E : 0600 0010           		addi.b  #$10,d0
(1)   23/   15552 :                     
(1)   24/   15552 :                     .nowater:
(1)   26/   15552 : 0828 0007 0039      		btst	#sta2ndSuper,obStatus2nd(a0)		; Is character Super?
(1)   27/   15558 : 6704                		beq.s   .nosuper							; If not, branch
(1)   28/   1555A : 0600 0020           		addi.b  #$20,d0
(1)   29/   1555E :                     
(1)   30/   1555E :                     .nosuper:
(1)   32/   1555E : 43FB 000A           		lea		SpeedSettings(pc,d0.w),a1			; Load correct speed settings into a1
(1)   33/   15562 : 5489                		addq.l  #2,a1                           	; Increment a1 by 2 quickly
(1)   34/   15564 : 24D9                		move.l  (a1)+,(a2)+                     	; Set character's new top speed and acceleration
(1)   35/   15566 : 3491                		move.w  (a1),(a2)                       	; Set character's deceleration
(1)   36/   15568 : 4E75                		rts
(1)   37/   1556A :                     ; End of function ApplySpeedSettings
