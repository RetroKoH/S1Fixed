(1)  141/       0 :                     ; Creates assertions for debugging
(1)  142/       0 :                     ; ---------------------------------------------------------------
(1)  143/       0 :                     ; EXAMPLES:
(1)  144/       0 :                     ;	assert.b	d0, eq, #1		; d0 must be $01, or else crash
(1)  145/       0 :                     ;	assert.w	d5, pl			; d5 must be positive
(1)  146/       0 :                     ;	assert.l	a1, hi, a0		; assert a1 > a0, or else crash
