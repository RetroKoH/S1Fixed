(1)  181/    143E : =$E                  DMAEntry	ENDSTRUCT
(1)  183/    143E :                     ; ---------------------------------------------------------------------------
(1)  184/    143E : =$12                 QueueSlotCount = (v_vdp_comm_buffer_slot-v_vdp_comm_buffer)/DMAEntry.len
(1)  185/    143E :                     ; ---------------------------------------------------------------------------
(1)  187/    143E : =$1                  		equ	DMAfunctions_defined,1
(1)  188/    143E :                     dmaSource function addr,((addr>>1)&$7FFFFF)
(1)  189/    143E :                     dmaLength function len,((len>>1)&$7FFF)
(1)  191/    143E :                     ; ---------------------------------------------------------------------------
(1)  193/    143E : =$1                  		equ	QueueStaticDMA_defined,1
(1)  194/    143E :                     is68kRegister function expr,symtype(expr)==8
(1)  195/    143E :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    143E :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    143E :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    143E :                     QueueStaticDMA macro src,length,dest
(1)  199/    143E :                     	if MOMPASS>1
(1)  200/    143E :                     		if ((src)&1)<>0
(1)  201/    143E :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    143E :                     		endif
(1)  203/    143E :                     		if ((length)&1)<>0
(1)  204/    143E :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    143E :                     		endif
(1)  206/    143E :                     		if (length)==0
(1)  207/    143E :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    143E :                     		endif
(1)  209/    143E :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    143E :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    143E :                     		endif
(1)  212/    143E :                     	endif
(1)  213/    143E :                     	if UseVIntSafeDMA==1
(1)  214/    143E :                     		move.w	sr,-(sp)										; Save current interrupt mask
(1)  215/    143E :                     		disableInts												; Mask off interrupts
(1)  216/    143E :                     	endif ; UseVIntSafeDMA==1
(1)  217/    143E :                     	movea.w	(v_vdp_comm_buffer_slot).w,a1
(1)  218/    143E :                     	cmpa.w	#v_vdp_comm_buffer_slot,a1
(1)  219/    143E :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    143E :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    143E :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
(1)  222/    143E :                     	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
(1)  223/    143E :                     	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
(1)  224/    143E :                     	if is68kRegister(dest)
(1)  225/    143E :                     		move.l	dest,(a1)+
(1)  226/    143E :                     	else
(1)  227/    143E :                     		move.l	#vdpComm(dest,VRAM,DMA),(a1)+					; Write VDP DMA command for destination address
(1)  228/    143E :                     	endif
(1)  229/    143E :                     	move.w	a1,(v_vdp_comm_buffer_slot).w						; Write next queue slot
(1)  230/    143E :                     .done:
(1)  231/    143E :                     	if UseVIntSafeDMA==1
(1)  232/    143E :                     		move.w	(sp)+,sr										; Restore interrupts to previous state
(1)  233/    143E :                     	endif ;UseVIntSafeDMA==1
(1)  234/    143E :                     	endm
(1)  236/    143E :                     ; ---------------------------------------------------------------------------
