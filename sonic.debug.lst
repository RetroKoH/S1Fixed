(2)  197/      C8 :                     
(2)  198/      C8 : 06 0B               	ld	b,pcmLoopCounter(16000)	; 7	; b = pitch of the SEGA sample
(2)  199/      CA : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  200/      CC :                     
(2)  201/      CC : 13                  	inc	de			; 6	; Point to next byte of DAC sample
(2)  202/      CD : 2B                  	dec	hl			; 6	; Decrement remaining bytes on DAC sample
(2)  203/      CE : 7D                  	ld	a,l			; 4	; a = low byte of remainig bytes
(2)  204/      CF : B4                  	or	h			; 4	; Are there any bytes left?
(2)  205/      D0 : C2 C1 00            	jp	nz,zPlaySEGAPCMLoop	; 10	; If yes, keep playing sample
(2)  206/      D3 :                     					; 90 in total
(2)  207/      D3 : C3 32 00            	jp	zCheckForSamples		; SEGA sound is done; wait for new samples
